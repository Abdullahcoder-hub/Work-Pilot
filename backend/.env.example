# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Your MongoDB Atlas (or other) connection string.
MONGO_URI=mongodb+srv://<atlas-username>:<atlas-password>@<cluster-url>/workpilot?retryWrites=true&w=majority

# Long, random secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API.
# DEPLOYED (Render): set this to your Vercel URL as an environment
# variable on your Render service (Environment tab) — not here, since this
# file is only the local-dev template. Requests from any origin not
# listed here get blocked by CORS, so this is the #1 thing to check if
# the deployed frontend can reach the API in the browser network tab but
# every request fails.
CLIENT_ORIGIN=http://localhost:5173,https://your-vercel-app.vercel.app

# Optional: bootstraps a single platform-level super_admin account on
# `npm run seed:superadmin`. Leave unset to skip.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Super Admin

# Brevo (https://brevo.com) is used to send verification, invite, and
# password-reset emails. Get an API key from the Brevo dashboard.
# Until this is set, emails are logged to the console instead of sent —
# useful for local development.
BREVO_API_KEY=
# Must be a verified sender in your Brevo account.
EMAIL_FROM=WorkPilot <you@yourdomain.com>
EMAIL_FROM_NAME=WorkPilot

# Base URL of the deployed frontend — used to build links inside emails
# (email verification, password reset, invite acceptance).
# DEPLOYED (Render): set this to your Vercel URL as an environment
# variable on your Render service too — left on localhost, every email
# link (verify/reset/invite) sent from production would point at
# someone's own laptop instead of your site.
APP_URL=https://your-vercel-app.vercel.app

# The AI Assistant is fully self-built (rule-based command parsing) and
# needs no API key or external service — nothing to configure here.
