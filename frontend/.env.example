# Copy to .env.local (Vite auto-loads it) and adjust if your backend runs elsewhere.
VITE_API_BASE_URL=http://localhost:5000/api

# Optional — Socket.IO connection target. Defaults to VITE_API_BASE_URL with
# the trailing /api stripped, so you usually don't need to set this.
# VITE_SOCKET_URL=http://localhost:5000
