# LOCAL DEV: copy this file to .env.local (gitignored, Vite auto-loads it)
# and adjust if your backend runs elsewhere.
#
# PRODUCTION (Vercel): not this file — see .env.production, which Vite
# picks up automatically during `vite build`. That one's already set to
# the deployed Railway backend and is committed to the repo since it's
# just a public URL, not a secret.
VITE_API_BASE_URL=http://localhost:5000/api

# Optional — Socket.IO connection target. Defaults to VITE_API_BASE_URL with
# the trailing /api stripped, so you usually don't need to set this.
# VITE_SOCKET_URL=http://localhost:5000
