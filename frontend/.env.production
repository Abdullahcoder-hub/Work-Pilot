# Used automatically by `vite build` (what Vercel runs to build the site).
# Local `npm run dev` is unaffected — it still falls back to localhost via
# .env.example unless you create a .env.local of your own.

VITE_API_BASE_URL=https://work-pilot-api.onrender.com/api

# Socket.IO connects to the server root, not the /api prefix — left unset
# on purpose so it auto-derives from VITE_API_BASE_URL above
# (https://work-pilot-api.onrender.com). Only set this if your Socket.IO
# server ever ends up on a different host than the REST API.
# VITE_SOCKET_URL=https://work-pilot-api.onrender.com
