# Used automatically by `vite build` (what Vercel runs to build the site).
# Local `npm run dev` is unaffected — it still falls back to localhost via
# .env.example unless you create a .env.local of your own.
#
# Replace with your actual Render backend domain once deployed. Render assigns
# one automatically (Settings > Dashboard > Generated URL), looking like
# <service-name>.onrender.com, or you can use a custom domain if configured.
VITE_API_BASE_URL=https://your-render-backend.onrender.com/api

# Socket.IO connects to the server root, not the /api prefix — left unset
# on purpose so it auto-derives from VITE_API_BASE_URL above. Only set
# this if your Socket.IO server ever ends up on a different host than
# the REST API.
# VITE_SOCKET_URL=https://your-render-backend.onrender.com
